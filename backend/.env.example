# ==========================================
# GeoAttend Backend Configuration (.env)
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=geoattend_jwt_secure_key_change_in_production_2026
JWT_EXPIRES_IN=24h

# Google Sheets Attendance Database
# Replace with your Google Spreadsheet ID (from Google Sheets URL)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Path to downloaded Google Service Account JSON file (recommended)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./config/google-service-account.json
# Alternatively, inline service account credentials:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Geofence & Location Validation Defaults
DEFAULT_OFFICE_RADIUS_METERS=100
MAX_ALLOWED_GPS_ACCURACY_METERS=50
MAX_LOCATION_AGE_SECONDS=60
REJECT_MOCK_LOCATIONS=true

# Biometric & Face Verification
# Options: 'local_liveness_engine' (built-in 1:1 cosine/euclidean face feature vector comparison with liveness challenge)
# or 'aws_rekognition', 'azure_face'
FACE_VERIFICATION_PROVIDER=local_liveness_engine
BIOMETRIC_STORAGE_PATH=./data/biometrics
FACE_CHALLENGE_TTL_SECONDS=120
FACE_MATCH_THRESHOLD=0.75

# Timezone Setting (Malaysia Standard Time)
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur

# Security & CORS
CORS_ORIGIN=*
